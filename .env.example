# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# The recurring price the checkout session subscribes the user to.
STRIPE_PRICE_ID=price_...
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Ads — the conversion tag id, e.g. AW-123456789.
# Loaded only in production builds; leave unset to disable tracking entirely.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Consent Mode v2 default. Defaults to `denied`, which is what UK/EU traffic
# requires before advertising cookies may be set; call setAdsConsent(true)
# from your consent banner to upgrade. Set to `granted` only where consent is
# captured before the app loads, or for US-only traffic.
NEXT_PUBLIC_ADS_CONSENT_DEFAULT=denied

# --- Analytics / Google Ads ---------------------------------------------
# Tag id, e.g. AW-123456789. Unset = no tag is injected at all.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Consent Mode v2 boots DENIED by default (required for UK/EU traffic).
# Set to "granted" only where consent is captured before the app loads.
NEXT_PUBLIC_ADS_CONSENT_DEFAULT=
# Absolute site origin; resolves canonical URLs. Must be set in production.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Launch toggles ------------------------------------------------------
# "true" lifts the 50-row free limit for everyone. Build-time and visible in
# the client bundle: a promotion switch, not an entitlement boundary.
NEXT_PUBLIC_DISABLE_PAYWALL=
